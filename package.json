{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "controller/**/*.js",
      "utils/**/*.js",
      "models/**/*.js"
    ],
    "coveragePathIgnorePatterns": ["/node_modules/"],
    "clearMocks": true,
    "setupFiles": ["<rootDir>/tests/setup.js"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "mongoose": "^9.1.3",
    "nanoid": "^5.1.6",
    "nodemon": "^3.1.11",
    "path": "^0.12.7",
    "redis": "^5.10.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
